<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Annual Printer Usage Report</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f0f4f8;
            color: #333;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        .container {
            width: 80%;
            margin: 40px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

        .section {
            margin-bottom: 40px;
        }

        .section h2 {
            color: #007BFF;
            font-size: 1.8em;
            margin-bottom: 20px;
        }

        .section p {
            font-size: 1.2em;
            color: #555;
        }

        .intro {
            text-align: center;
            padding: 40px 0;
            background: linear-gradient(135deg, #6ab7ff, #009eff);
            color: #fff;
            border-radius: 15px;
        }

        .intro h1 {
            font-size: 3em;
            margin-bottom: 20px;
        }

        .intro .total-pages {
            font-size: 2.5em;
            margin-top: 10px;
            color: #ffd700;
        }

        .chart, .pie-chart {
            width: 100%;
            height: 300px;
            background-color: #e0e7ff;
            border-radius: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5em;
            color: #007BFF;
            margin-bottom: 20px;
        }

        .environment-impact, .printing-habits {
            display: flex;
            justify-content: space-around;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 15px;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.05);
        }

        .environment-impact div, .printing-habits div {
            text-align: center;
            width: 45%;
        }

        .badge {
            display: inline-block;
            padding: 15px 30px;
            background-color: #FFC107;
            color: #fff;
            border-radius: 50px;
            margin: 10px;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            font-size: 1.1em;
        }

        .thank-you {
            text-align: center;
            padding: 30px;
            background-color: #e9ecef;
            border-radius: 15px;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.05);
        }

        .thank-you h3 {
            color: #28A745;
            font-size: 2em;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Introduction Section -->
    <div class="section intro">
        <h1>Welcome to Your Annual Printer Usage Report!</h1>
        <p class="total-pages">Total Pages Printed: 12,345</p>
    </div>

    <!-- Print Volume Statistics Section -->
    <div class="section">
        <h2>Print Volume Statistics</h2>
        <div class="chart">[Bar/Line Chart for Monthly Print Volume]</div>
    </div>

    <!-- Print Content Analysis Section -->
    <div class="section">
        <h2>Print Content Analysis</h2>
        <div class="pie-chart">[Pie Chart for Document Types]</div>
    </div>

    <!-- Environmental Impact Section -->
    <div class="section environment-impact">
        <div>
            <h2>Paper Usage</h2>
            <p>Equivalent to 2 trees saved</p>
        </div>
        <div>
            <h2>Double-sided Printing</h2>
            <p>60% of total prints</p>
        </div>
    </div>

    <!-- Printing Habits Section -->
    <div class="section printing-habits">
        <div>
            <h2>Average Pages per Print Job</h2>
            <p>15 pages</p>
        </div>
        <div>
            <h2>Most Common Printing Time</h2>
            <p>Afternoon</p>
        </div>
    </div>

    <!-- Fun Facts Section -->
    <div class="section">
        <h2>Fun Facts</h2>
        <div class="chart">Longest Distance for Remote Print: 500 miles</div>
        <div class="chart">Comparison with Colleagues: You printed 20% more than your peers!</div>
    </div>

    <!-- Annual Achievements Section -->
    <div class="section">
        <h2>Annual Achievements</h2>
        <span class="badge">Eco-friendly User</span>
        <span class="badge">Printing Master</span>
    </div>

    <!-- Conclusion Section -->
    <div class="section thank-you">
        <h3>Thank You for Using Our Printing Services!</h3>
        <p>We look forward to helping you print more efficiently in the coming year.</p>
    </div>
</div>

</body>
</html>